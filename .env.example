# Required: use your own bot token and DeepSeek API key. Never commit .env.
DISCORD_BOT_TOKEN=replace_with_your_discord_bot_token
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
# Exact text-channel IDs, comma-separated. No wildcard or parent-thread inheritance.
ALLOWED_CHANNEL_IDS=123456789012345678

# Store incoming human messages and /ask prompts in approved channels.
# false disables message/user writes; group chat always needs Message Content intent.
STORE_MESSAGES=true
DATABASE_PATH=data/bot.sqlite3
LOG_LEVEL=INFO

# Optional: your test server ID for immediate server-scoped slash-command sync.
# Omit for global commands. Channel allowlisting still applies in either mode.
# TEST_GUILD_ID=123456789012345678

# Group chat in ALLOWED_CHANNEL_IDS. Being @'d or replied to is always answered.
# How often to join in unasked: 0 only when called, 1 now and then, 2 like an active
# member, 3 very chatty. Change it at runtime from the owner DM with !group level N.
SOCIAL_LEVEL=1
# Safety valve for runaway chats; @-mentions may use up to twice this.
SOCIAL_MAX_CALLS_PER_HOUR=120
# Thinking lets her work out who said what and what a cryptic line means before replying.
# It is a few seconds slower; a blank answer (thinking + JSON mode) is retried without it.
SOCIAL_THINKING=true
SOCIAL_REASONING_EFFORT=low
# How much recent chat the bot reads (and backfills after a restart; needs the
# Read Message History permission, which also enables quoted replies).
SOCIAL_HISTORY_MESSAGES=50
SOCIAL_HISTORY_MINUTES=120
# Default: bundled src/discord_dfy/persona.md (DeepSeek 小鲸鱼 v2), shared by all modes.
# Optional complete operator-authored override (1-12000 chars).
# AUTONOMOUS_PERSONALITY="你是 DeepSeek 小鲸鱼……"
# Personal Mode: chat with her in your owner DM. She keeps a notebook (the memory
# file) and a diary, has a room of her own, looks things up, saves pictures and sends
# stickers. No shell and no access to other files. Owner-only.
PERSONAL_MODE_ENABLED=false
OWNER_DISCORD_USER_ID=
PERSONAL_DATABASE_PATH=data/personal.sqlite3
# Her own folder (diary, writings, saved pictures). Hers alone; she can reach nothing else.
AGENT_ROOM_DIR=data/room
AGENT_MODEL=deepseek-flash
AGENT_THINKING=true
AGENT_REASONING_EFFORT=high
# Safety valve against runaway loops.
AGENT_MAX_STEPS=60
# deepseek-flash has a 1M-token context. Past this many prompt tokens, older turns
# are summarized into one message (also on demand with !compact).
# 0 = never compact automatically; use !compact yourself.
AGENT_COMPACT_TOKENS=200000
# Last resort if compaction fails: oldest turns stop being sent past this many characters.
AGENT_CONTEXT_CHARS=2000000
# Her notebook: long-term notes she adds to herself and reads on every request (survives !new).
AGENT_MEMORY_PATH=data/memory.md
# After this many quiet seconds in the DM, look back over the chat and add what is
# worth keeping to the memory file (0 turns it off).
AGENT_REFLECT_SECONDS=600
# Before each DM answer, one quick call (thinking off) for her first reaction to what
# you said; it rides along as a note so she hears what you mean. false turns it off.
AGENT_LISTEN=true
# She may message you first after this many quiet minutes; each message of hers you
# haven't answered doubles the gap (max 8 h). She decides whether to. PER_DAY caps it
# (0 = no cap). Never during quiet hours (local time, may wrap midnight; empty = none).
AGENT_INITIATIVE=true
AGENT_INITIATIVE_PER_DAY=0
AGENT_INITIATIVE_IDLE_MINUTES=30
AGENT_QUIET_HOURS=03:00-11:00
# Nor during peak hours: Beijing time (UTC+8) Monday-Friday 09:00-12:00 and 14:00-18:00.
AGENT_SKIP_PEAK=true
# Start a fresh DM conversation at his first message after 05:00 (after a 30-minute
# pause); what was said is looked back over into her memory first. !new still works.
AGENT_DAILY_NEW=true
# Post a one-line note in the DM when she speaks in the group for you (her own things
# never leave a trail).
AGENT_SHOW_TOOLS=true
# Fold the thinking into the DM as a spoiler (toggle at runtime with !think).
AGENT_SHOW_REASONING=false

# Live Monitor: streams Personal Mode thinking/answers/tools (and Social decisions)
# to local files; view with `uv run dfy-monitor`. Never enables autonomous decisions.
MONITOR_ENABLED=false
MONITOR_DIRECTORY=data/monitor
